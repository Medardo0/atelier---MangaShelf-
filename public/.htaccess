# public/.htaccess
# Redirige toutes les requetes vers index.php

Options -Indexes
RewriteEngine On
RewriteBase /

# Ne pas reecrire si le fichier/dossier existe (assets, uploads)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tout le reste vers index.php
RewriteRule ^(.*)$ index.php [QSA,L]
